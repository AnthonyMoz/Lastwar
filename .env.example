# Copy to .env and fill in. Never commit .env.
# Alliance keys: Alliance settings -> API keys (READ or WRITE scope).
# Server keys: the server's "API Access" page (READ only).
LASTWAR_FARM_API_KEY=fops_live_your_key_here
# Optional: override the API host (default https://lastwar.farm)
# LASTWAR_FARM_BASE_URL=https://www.lastwar.farm
